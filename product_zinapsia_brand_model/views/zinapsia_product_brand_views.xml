<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zinapsia_product_brand_list_view" model="ir.ui.view">
        <field name="name">zinapsia.product.brand.list</field>
        <field name="model">zinapsia.product.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="zinapsia_product_brand_form_view" model="ir.ui.view">
        <field name="name">zinapsia.product.brand.form</field>
        <field name="model">zinapsia.product.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Brand"/>
                        <h1><field name="name" placeholder="e.g. Acme"/></h1>
                    </div>
                    <group name="main">
                        <field name="active" invisible="1"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="zinapsia_product_brand_search_view" model="ir.ui.view">
        <field name="name">zinapsia.product.brand.search</field>
        <field name="model">zinapsia.product.brand</field>
        <field name="arch" type="xml">
            <search string="Brands">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="zinapsia_product_brand_action" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">zinapsia.product.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new brand
            </p>
        </field>
    </record>

    <menuitem
        id="menu_zinapsia_product_brand"
        name="Brands"
        action="zinapsia_product_brand_action"
        parent="stock.menu_product_in_config_stock"
        sequence="3"
        groups="stock.group_stock_manager"/>

</odoo>
